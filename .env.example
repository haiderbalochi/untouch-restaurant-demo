# ─────────────────────────────────────────────────────────────
#  UNTOUCH — environment template
#  Copy to .env.local and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=PKR

# ---------- Firebase web client (public) ----------
# Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=untouch-returant.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=untouch-returant
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=untouch-returant.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://untouch-returant-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- Firebase Admin (server only — NEVER expose to the browser) ----------
# Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep newlines escaped as \n when stored on one line (Vercel / Sites).
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative: paste the whole service-account JSON (single line, base64 or raw JSON).
# When set, it takes precedence over the three values above.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Realtime Database URL used by the Admin SDK (defaults to the public URL above).
# FIREBASE_ADMIN_DATABASE_URL=https://untouch-returant-default-rtdb.firebaseio.com

# ---------- Admin panel (server only) ----------
# Password for /unnothingadmin. Checked server-side; never sent to the browser bundle.
ADMIN_PANEL_PASSWORD=
# Signs the HttpOnly admin session cookie. Generate with: openssl rand -hex 48
ADMIN_SESSION_SECRET=

# ---------- Cloudinary (server only) ----------
# Console → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public, safe to expose — used for responsive URL building on the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_FOLDER=untouch

# ---------- Payments (online payments intentionally unconfigured) ----------
# Supported provider keys: jazzcash | easypaisa | safepay
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_INTEGRITY_SALT=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# ---------- Optional: Firebase emulator suite for local development ----------
# Auth listens on 9099, Realtime Database on 9000.
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# GCLOUD_PROJECT=untouch-returant
